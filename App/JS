  $("#gm").textContent = "Muscles worked: " + g.muscles + ".";
  $("#cap").textContent = g.exercises.length + " exercises for " + g.name.toLowerCase();
  $$(".z").forEach((z) => z.classList.toggle("on", z.dataset.g === currentGroup));
  $$("#chips button").forEach((b) => b.setAttribute("aria-pressed", b.dataset.g === currentGroup));
  $("#list").innerHTML = g.exercises
    .map(
      ([name, muscles, setsReps, steps]) =>
        `<details class="dx"><summary><span><b>${name}</b><small>${muscles}</small></span><em>${setsReps}<small> sets × reps</small></em></summary><ol>${steps
