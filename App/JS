  $$(".pg").forEach((s) => (s.hidden = s.id !== p));
  $$(".lk").forEach((a) => a.classList.toggle("cur", a.dataset.p === p));
  if (p !== currentPage) scrollTo(0, 0);
  currentPage = p;
}
function go(p) {
  try {
    location.hash = p;
  } catch (e) {}
  show(p);
}
function draw() {
  const g = exerciseGroups[currentGroup];
