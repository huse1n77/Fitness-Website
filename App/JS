const $ = (s) => document.querySelector(s),
  $$ = (s) => [...document.querySelectorAll(s)],
  round = Math.round,
  formatNumber = (n) => round(n).toLocaleString("en-US"),
  escapeHtml = (s) =>
    String(s).replace(
      /[&<>"]/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c],
    );
const bodyMapSvg =
  '<svg viewBox="0 0 200 256" role="group" aria-label="Muscle groups"><circle class="hd" cx="100" cy="26" r="14"/><rect class="hd" x="93" y="40" width="14" height="12" rx="4"/>' +
